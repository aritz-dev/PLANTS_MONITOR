# COPIA este fichero a 'terraform.tfvars' y rellena tus valores.
# terraform.tfvars esta en .gitignore (contiene secretos).

pve_api_url      = "https://192.168.1.141:8010/api2/json"   # port-forward a nodo1:8006

# Usuario dedicado (privilegio minimo), NO root:
pve_token_id     = "OpenTofu-admin@pve!myToken"
pve_token_secret = "PEGA-AQUI-EL-SECRETO-DEL-TOKEN"

lxc_password = "cambia-esto"

lxcs = {
  lxc1 = { target_node = "nodo1", hostname = "lxc-nodo1", ip = "10.0.10.21/24" }
  lxc2 = { target_node = "nodo2", hostname = "lxc-nodo2", ip = "10.0.10.22/24" }
  lxc3 = { target_node = "nodo3", hostname = "lxc-nodo3", ip = "10.0.10.23/24" }
}
